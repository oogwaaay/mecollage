{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/tools/(.*)", "destination": "/public/tools/$1" }
  ],
  "redirects": [
    {
      "source": "/public/tools/(.*)",
      "destination": "/tools/$1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "zh"
        }
      ],
      "destination": "/zh/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "es"
        }
      ],
      "destination": "/es/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "ja"
        }
      ],
      "destination": "/ja/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "tw"
        }
      ],
      "destination": "/tw/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/",
      "permanent": true
    }
  ]
}
